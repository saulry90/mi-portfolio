{
  "name": "mi-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sass:watch": "sass --watch src/scss/main.scss:src/css/style.css --embed-source-map --no-error-css",
    "sass:build": "sass src/scss/main.scss:src/css/style.css --style=compressed --no-source-map",
    "postcss:build": "postcss src/css/style.css -o src/css/style.css",
    "start": "concurrently \"npm run sass:watch\" \"npm run dev\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.93.2",
    "vite": "^7.1.7"
  }
}
